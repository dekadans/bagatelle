{% extends "layout.html.twig" %}

{% block title %}{{ page_title ?? 'Bagatelle' }}{% endblock %}

{% block content %}
    <section>
        <h1>{{ title }}</h1>

        {% if message %}
            <p>{{ message }}</p>
        {% else %}
            <p>
                👋 Welcome to <a href="https://github.com/dekadans/bagatelle">Bagatelle</a>,
                a PHP boilerplate bundle for simple applications.
            </p>
        {% endif %}
    </section>

    {% if exception %}
        <section>
            <h2>Exception Details</h2>
            <pre><code>
{%- for ex in exception %}
<span class="error-type">{{ ex.class }}</span>
{% if ex.message -%} {{ ex.message }} {%- endif %}


<span class="error-type">Stack trace:</span>
{% for trace in ex.trace %}
at <span class="file-path">{{ trace.file }}</span>:<span class="line-number">{{ trace.line }}</span>
    {{ trace.function }}
{% endfor %}

<hr>
{% endfor %}
            </code></pre>
        </section>
    {% endif %}
{% endblock %}
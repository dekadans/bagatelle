<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- "musical note" from twemoji -->
    <link rel="icon" href="data:image/svg+xml;base64," />
    <title>{% block title %}{% endblock %}</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #e8eaf0 0%, #f4f5f7 100%);
            min-height: 100vh;
            padding: 3rem 2rem;
            color: #4a5568;
            line-height: 1.6;
        }

        main {
            max-width: 1200px;
            margin: 0 auto;
        }

        section {
            background: #ffffff;
            width: 100%;
            padding: 2rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05), 0 10px 20px rgba(0, 0, 0, 0.08);
            margin-bottom: 2rem;
        }

        h1 {
            font-size: 2rem;
            font-weight: 600;
            color: #2d3748;
            letter-spacing: -0.025em;
        }

        h2 {
            font-size: 1.25rem;
            font-weight: 600;
            color: #2d3748;
            letter-spacing: -0.025em;
        }

        p {
            font-size: 1.0625rem;
            color: #5a6c7d;
            line-height: 1.75;
        }

        pre {
            background: #2d3748;
            color: #e2e8f0;
            padding: 1.5rem;
            border-radius: 8px;
            overflow-x: auto;
            font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
            font-size: 0.875rem;
            line-height: 1.6;
            border: 1px solid #4a5568;
        }

        .error-type {
            color: #fc8181;
            font-weight: 600;
        }

        .file-path {
            color: #90cdf4;
        }

        .line-number {
            color: #fbd38d;
        }

        @media (max-width: 768px) {
            body {
                padding: 2rem 1rem;
            }

            section {
                padding: 1.5rem;
            }

            h1 {
                font-size: 1.75rem;
            }

            p {
                font-size: 1rem;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 1.5rem 1rem;
            }

            section {
                padding: 1.25rem;
            }

            h1 {
                font-size: 1.5rem;
                margin-bottom: 1.25rem;
            }

            h2 {
                font-size: 1.125rem;
            }
        }
    </style>
</head>
<body>
<main>
    {% block content %}{% endblock %}
</main>
</body>
</html>